---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, resources } from '../data/content.js';
---
<Layout title={`Resources | ${site.brand}`}>
<Header/>
<main id="main-content">
  <div class="wrap page-header">
    <span class="tag" aria-hidden="true">Links</span>
    <h1 class="page-title" style="margin-top:12px;">Resources</h1>
    <p class="page-subtitle">Further reading and related work.</p>
  </div>
  <section class="section"><div class="wrap">
    <ul class="grid-3" role="list" style="padding:0;list-style:none;">
      {resources.map(r => (<li><article class="card"><h3>{r.title}</h3><p class="muted" style="font-size:.9rem;margin:8px 0;">{r.description}</p><div class="card-meta"><a class="card-link" href={r.url} target="_blank" rel="noopener noreferrer">Open ↗<span class="sr-only"> (opens in new tab)</span></a></div></article></li>))}
    </ul>
  </div></section>
</main>
<Footer/>
</Layout>
