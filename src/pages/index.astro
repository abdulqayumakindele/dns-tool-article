---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, stack } from '../data/content.js';
---
<Layout title={site.name}>
<Header/>
<main id="main-content">
  <section class="hero wrap" aria-labelledby="hero-name">
    <span class="eyebrow" aria-hidden="true">Article + Python Tool</span>
    <h1 id="hero-name">{site.brand}</h1>
    <h2>{site.tagline}</h2>
    <p>Read the explanation, see the diagram, then run the code yourself.</p>
    <div class="actions">
      <a class="btn primary" href="/article">Read the Article</a>
      <a class="btn" href="/tool">Try the Tool</a>
    </div>
  </section>
  <section class="section" aria-labelledby="inside-h">
    <div class="wrap">
      <h2 class="section-title" id="inside-h">What's Inside</h2>
      <p class="section-lead">Stack: {stack.join(' · ')}</p>
      <ul class="grid-3" role="list" style="padding:0;list-style:none;">
        <li><article class="card"><span class="tag">Writing</span><h3 style="margin-top:10px;">The Article</h3><p class="muted" style="font-size:.9rem;margin-top:8px;">What DNS and resolvers are, record types, CNAME chains, and how the tool differs from a browser lookup.</p><div class="card-meta"><a class="card-link" href="/article">Read →</a></div></article></li>
        <li><article class="card"><span class="tag">Diagram</span><h3 style="margin-top:10px;">The Lookup Flow</h3><p class="muted" style="font-size:.9rem;margin-top:8px;">A simplified visual of device, resolver, root, TLD, and authoritative server.</p><div class="card-meta"><a class="card-link" href="/article#diagram">See it →</a></div></article></li>
        <li><article class="card"><span class="tag">Code</span><h3 style="margin-top:10px;">The Python Tool</h3><p class="muted" style="font-size:.9rem;margin-top:8px;">Look up A, AAAA, CNAME, MX, NS and TXT records and trace CNAME chains.</p><div class="card-meta"><a class="card-link" href="/tool">Open →</a></div></article></li>
      </ul>
    </div>
  </section>
</main>
<Footer/>
</Layout>
